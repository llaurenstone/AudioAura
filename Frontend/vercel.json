{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://audioaura-iq99.onrender.com/auth/$1"
    },
    {
      "source": "/get/(.*)",
      "destination": "https://audioaura-iq99.onrender.com/get/$1"
    },
    {
      "source": "/share/(.*)",
      "destination": "https://audioaura-iq99.onrender.com/share/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}